{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "env": {
    "NEXT_PUBLIC_MEDUSA_BACKEND_URL": "https://your-medusa-backend.vercel.app",
    "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY": "@medusa-publishable-key",
    "NEXT_PUBLIC_MEDUSA_REGION_ID": "reg_egypt_001",
    "NEXT_PUBLIC_MEILI_URL": "https://your-meilisearch.vercel.app",
    "NEXT_PUBLIC_MEILI_SEARCH_KEY": "@meilisearch-key"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_SITE_URL": "@site-url"
    }
  },
  "functions": {
    "app/**/*.ts": {
      "maxDuration": 30
    }
  }
}
