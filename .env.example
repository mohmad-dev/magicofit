# ── Database (PostgreSQL 16) ──
POSTGRES_DB=magicofit
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medusa:medusa_password@localhost:5432/magicofit

# ── Redis ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Meilisearch ──
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey123
MEILI_ENV=development
MEILI_NO_ANALYTICS=true

# ── MedusaJS Backend ──
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:7001

# ── Auth ──
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production

# ── Search ──
MEILI_INDEX_PREFIX=magicofit_

# ── WhatsApp / Twilio ──
TWILIO_ACCOUNT_SID=AC_
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# ── Image Storage ──
STORAGE_URL=https://storage.magicofit.com
